# URL of the FastAPI backend (Render)
NEXT_PUBLIC_API_URL=https://your-app.onrender.com

# Supabase Auth (Google sign-in). These are public, client-safe values.
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Comma-separated Google accounts allowed in the dashboard (enforced again server-side).
NEXT_PUBLIC_ALLOWED_EMAIL=owner@demologistics.com,ap.clerk@demologistics.com
