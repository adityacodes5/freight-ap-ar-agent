# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Zoho Mail ───────────────────────────────────────────────────────────────
# Register a Self Client at https://api-console.zoho.com
# Required scopes: ZohoMail.accounts.READ,ZohoMail.messages.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Your Zoho Mail account ID (run `python main.py --get-account-id` after setup)
ZOHO_ACCOUNT_ID=

# Zoho datacenter base URLs:
#   US:     https://mail.zoho.com/api   / https://accounts.zoho.com/oauth/v2/token
#   India:  https://mail.zoho.in/api    / https://accounts.zoho.in/oauth/v2/token
#   EU:     https://mail.zoho.eu/api    / https://accounts.zoho.eu/oauth/v2/token
ZOHO_MAIL_BASE_URL=https://mail.zoho.com/api
ZOHO_AUTH_URL=https://accounts.zoho.com/oauth/v2/token

# ─── Google Sheets ───────────────────────────────────────────────────────────
# Path to your service account JSON (share the sheet with the service account email)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# The ID in the Google Sheet URL: docs.google.com/spreadsheets/d/{THIS_PART}/
GOOGLE_SHEET_ID=

# Sheet tab names (adjust to match yours)
SALES_SHEET_NAME=Sales
ACCOUNTS_SHEET_NAME=Accounts

# ─── Agent Behaviour ─────────────────────────────────────────────────────────
# Filter emails by sender (optional — leave blank to search all mail)
DISPATCH_EMAIL_SENDER=
# Subject/body keyword used to search for invoice emails
INVOICE_SEARCH_QUERY=invoice carrier
# How many days back to look for unprocessed invoices
LOOKBACK_DAYS=14

# ─── Database (optional) ─────────────────────────────────────────────────────
# Supabase Postgres for durable agent state (extraction cache, processed
# invoices, forward-to-dispatch queue). If unset, the agent falls back to local
# JSON files (fine for dev, but state is lost on Render redeploys).
# Use the Supabase "Connection pooling" string (port 6543, transaction mode):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Dashboard auth (Google via Supabase) ────────────────────────────────────
# The API validates the dashboard user's Supabase token and only lets these
# Google accounts through (comma-separated). Code has working defaults.
ALLOWED_EMAIL=owner@demologistics.com,ap.clerk@demologistics.com
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Max AI extraction readings to keep cached (older ones evicted). Keeps the
# Postgres cache table small. Default 500.
CACHE_MAX=500

# ─── Project 2 feed (optional) ───────────────────────────────────────────────
# Push verified invoices into the project 2 ERP dashboard via its REST API.
# Both must be set to activate; otherwise the feed is a no-op (p2_client.py).
# P2_SERVICE_KEY must match SERVICE_API_KEY in project 2's backend env.
P2_API_URL=
P2_SERVICE_KEY=
